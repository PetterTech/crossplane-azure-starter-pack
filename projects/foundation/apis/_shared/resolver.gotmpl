{{- /*
  Shared subscription resolver (accepted exception E6). Identical in every building-block
  composition (step "resolve-subscription"); packages cannot share files, so the text is inlined
  and scripts/validate.sh checks it against projects/foundation/apis/_shared/resolver.gotmpl.
  Behaviour is documented in projects/foundation/apis/_shared/resolver.md. Do not edit one copy.
*/ -}}
{{- $xr := .observed.composite.resource -}}
{{- $kind := $xr.kind -}}
{{- $ns := dig "metadata" "namespace" "" $xr -}}
{{- $spec := get $xr "spec" | default dict -}}
{{- $params := get $spec "parameters" | default dict -}}
{{- $st := get $xr "status" | default dict -}}
{{- $env := index .context "apiextensions.crossplane.io/environment" | default dict -}}
{{- $er := .extraResources | default dict -}}
{{- if not $ns }}{{ fail "SubscriptionNotFound: the resource has no namespace" }}{{ end }}
---
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ExtraResources
requirements:
  subs:
    apiVersion: platform.a5n.io/v1alpha1
    kind: Subscription
    namespace: {{ $ns | quote }}
{{- if eq $kind "LandingZone" }}
  vnets:
    apiVersion: platform.a5n.io/v1alpha1
    kind: VirtualNetwork
    namespace: {{ $ns | quote }}
{{- end }}
{{- /* The first call of a reconcile has no result yet: only the requirement above is returned. */}}
{{- if and (hasKey $er "subs") (or (ne $kind "LandingZone") (hasKey $er "vnets")) }}
{{- $subs := list -}}
{{- range $i := (get (get $er "subs") "items" | default list) }}{{ $subs = append $subs $i.resource }}{{ end -}}
{{- $names := list -}}
{{- $ready := list -}}
{{- range $s := $subs -}}
  {{- $names = append $names $s.metadata.name -}}
  {{- $ok := false -}}
  {{- range $c := (get ($s.status | default dict) "conditions" | default list) -}}
    {{- if and (eq $c.type "Ready") (eq $c.status "True") }}{{ $ok = true }}{{ end -}}
  {{- end -}}
  {{- if and $ok (not (hasKey $s.metadata "deletionTimestamp")) }}{{ $ready = append $ready $s }}{{ end -}}
{{- end -}}

{{- if eq $kind "LandingZone" -}}
{{- /* LandingZone creates its own Subscription (a composed resource), so a Subscription that does not exist yet or is not Ready is a wait, not a failure: only conditions are returned and nothing is pinned. Everything else fails closed. The Subscription must be controlled by this landing zone (D12). The virtual network is read from the same namespace and must belong to the landing zone's subscription. */ -}}
{{- $want := get $spec "subscription" | default "" -}}
{{- $pinnedSub := get $st "subscription" | default "" -}}
{{- $subName := $pinnedSub | default ($want | default $xr.metadata.name) -}}
{{- if and $pinnedSub $want (ne $want $pinnedSub) }}{{ fail (printf "SubscriptionMismatch: spec.subscription is '%s' but this resource is pinned to Subscription '%s'. Create a new resource to move." $want $pinnedSub) }}{{ end -}}
{{- $sub := dict -}}
{{- range $s := $subs }}{{ if eq $s.metadata.name $subName }}{{ $sub = $s }}{{ end }}{{ end -}}
{{- $subWait := "" -}}
{{- if not $sub -}}
  {{- if $pinnedSub }}{{ fail (printf "SubscriptionChanged: pinned Subscription '%s' was not found in namespace '%s'. Existing resources are kept." $pinnedSub $ns) }}{{ end -}}
  {{- $subWait = printf "Waiting for Subscription '%s' to be created." $subName -}}
{{- else -}}
  {{- $mine := false -}}
  {{- range $o := (get $sub.metadata "ownerReferences" | default list) }}{{ if and (eq (get $o "uid") $xr.metadata.uid) (get $o "controller" | default false) }}{{ $mine = true }}{{ end }}{{ end -}}
  {{- if not $mine }}{{ fail (printf "SubscriptionNotControlled: Subscription '%s' exists in namespace '%s' but is not controlled by this landing zone. Choose another name in spec.subscription. Nothing is created." $subName $ns) }}{{ end -}}
  {{- $isReady := false -}}
  {{- range $s := $ready }}{{ if eq $s.metadata.name $subName }}{{ $isReady = true }}{{ end }}{{ end -}}
  {{- $subIDNow := get ($sub.status | default dict) "subscriptionId" | default "" -}}
  {{- if $pinnedSub -}}
    {{- if or (not (get $st "subscriptionUid")) (not (get $st "subscriptionId")) }}{{ fail (printf "SubscriptionChanged: the pin of Subscription '%s' is incomplete. Delete and recreate this resource." $pinnedSub) }}{{ end -}}
    {{- if ne $sub.metadata.uid (get $st "subscriptionUid") }}{{ fail (printf "SubscriptionChanged: Subscription '%s' has a different uid than the pin (deleted and recreated?). Existing resources are kept." $pinnedSub) }}{{ end -}}
    {{- if ne $subIDNow (get $st "subscriptionId") }}{{ fail (printf "SubscriptionChanged: Subscription '%s' reports a different subscriptionId than the pin. Existing resources are kept." $pinnedSub) }}{{ end -}}
    {{- if not $isReady }}{{ fail (printf "SubscriptionNotReady: pinned Subscription '%s' is not Ready or is being deleted. Existing resources are kept." $pinnedSub) }}{{ end -}}
  {{- else if or (not $isReady) (not $subIDNow) -}}
    {{- $subWait = printf "Waiting for Subscription '%s' to be Ready." $subName -}}
  {{- end -}}
{{- end -}}
{{- if $subWait }}
---
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ClaimConditions
conditions:
  - type: SubscriptionResolved
    status: "False"
    reason: SubscriptionPending
    message: {{ $subWait | quote }}
    target: Composite
{{- else -}}
{{- $subID := get $sub.status "subscriptionId" -}}
{{- $pinEnv := get $st "environment" | default dict -}}
{{- $envLoc := get $env "location" | default "" -}}
{{- $loc := get $pinEnv "location" | default (get $params "location" | default $envLoc) -}}
{{- $rg := get $pinEnv "resourceGroupName" | default (get $params "resourceGroupName" | default (printf "rg-%s" $xr.metadata.name)) -}}
{{- if not (regexMatch `^[a-z][a-z0-9]*$` $loc) }}{{ fail (printf "EnvironmentInvalid: the location %q is not a valid region. Set it in the platform-environment EnvironmentConfig or spec.parameters.location." $loc) }}{{ end -}}
{{- if not (regexMatch `^[A-Za-z0-9._()-]*[A-Za-z0-9_()-]$` $rg) }}{{ fail (printf "EnvironmentInvalid: the resource group %q is not valid." $rg) }}{{ end -}}
{{- $drift := list -}}
{{- if get $pinEnv "location" -}}
  {{- if and (not (get $params "location")) (ne $envLoc (get $pinEnv "location")) }}{{ $drift = append $drift (printf "location is '%s' in the EnvironmentConfig, '%s' in use" $envLoc $loc) }}{{ end -}}
{{- else -}}
  {{- $allowed := get $env "allowedLocations" | default "" -}}
  {{- if $allowed -}}
    {{- $list := list -}}
    {{- range $a := splitList "," $allowed }}{{ $list = append $list (trim $a | lower) }}{{ end -}}
    {{- if not (has $loc $list) }}{{ fail (printf "LocationNotAllowed: location '%s' is not in the allowed locations (%s)." $loc (join ", " $list)) }}{{ end -}}
  {{- end -}}
{{- end -}}
{{- $pinNet := get $st "network" | default dict -}}
{{- $vnName := get $pinNet "virtualNetwork" | default (get $spec "virtualNetwork" | default "") -}}
{{- if and (not $vnName) (hasKey $params "network") }}{{ $vnName = $xr.metadata.name }}{{ end -}}
{{- $subnetOut := get $pinNet "subnetId" | default "" -}}
{{- $netOK := true -}}
{{- $netReason := "VirtualNetworkResolved" -}}
{{- $netMsg := printf "Using virtual network '%s'." $vnName -}}
{{- if and $vnName (not $subnetOut) -}}
  {{- $vn := dict -}}
  {{- range $i := (get (get $er "vnets") "items" | default list) }}{{ if eq $i.resource.metadata.name $vnName }}{{ $vn = $i.resource }}{{ end }}{{ end -}}
  {{- $vst := get $vn "status" | default dict -}}
  {{- if not $vn -}}
    {{- $netOK = false -}}{{- $netReason = "VirtualNetworkNotFound" -}}{{- $netMsg = printf "Waiting for VirtualNetwork '%s' in namespace '%s'." $vnName $ns -}}
  {{- else if or (not (get $vst "subscriptionId")) (not (get $vst "subnetId")) -}}
    {{- $netOK = false -}}{{- $netReason = "VirtualNetworkNotReady" -}}{{- $netMsg = printf "Waiting for VirtualNetwork '%s' to be resolved and to have a subnet." $vnName -}}
  {{- else if ne (lower (get $vst "subscriptionId")) (lower $subID) -}}
    {{- fail (printf "VirtualNetworkNotInSubscription: VirtualNetwork '%s' belongs to another subscription than this landing zone's. Use a virtual network created with spec.subscription '%s'." $vnName $subName) -}}
  {{- else if not (regexMatch (printf `(?i)^/subscriptions/%s/resourcegroups/[^/]+/providers/microsoft\.network/virtualnetworks/[^/]+/subnets/[^/]+$` $subID) (get $vst "subnetId")) -}}
    {{- fail (printf "VirtualNetworkNotInSubscription: the subnet of VirtualNetwork '%s' is not in this landing zone's subscription." $vnName) -}}
  {{- else -}}
    {{- $subnetOut = get $vst "subnetId" -}}
  {{- end -}}
{{- end }}
---
apiVersion: {{ $xr.apiVersion }}
kind: {{ $kind }}
status:
  subscription: {{ $sub.metadata.name | quote }}
  subscriptionUid: {{ $sub.metadata.uid | quote }}
  subscriptionId: {{ $subID | quote }}
{{- if get ($sub.status | default dict) "providerConfigName" }}
  providerConfigName: {{ get $sub.status "providerConfigName" | quote }}
{{- end }}
  environment:
    location: {{ $loc | quote }}
    resourceGroupName: {{ $rg | quote }}
{{- if $subnetOut }}
  network:
    virtualNetwork: {{ $vnName | quote }}
    subnetId: {{ $subnetOut | quote }}
{{- end }}
---
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ClaimConditions
conditions:
  - type: SubscriptionResolved
    status: "True"
    reason: SubscriptionResolved
    message: {{ printf "Using Subscription '%s' (%s)." $sub.metadata.name "created by this landing zone" | quote }}
    target: Composite
  - type: EnvironmentValid
    status: "True"
    reason: EnvironmentValid
    message: "The platform environment is valid."
    target: Composite
  - type: EnvironmentDrift
    status: {{ ternary "True" "False" (gt (len $drift) 0) | quote }}
    reason: {{ ternary "EnvironmentChanged" "InSync" (gt (len $drift) 0) }}
    message: {{ ternary (printf "Pinned values are kept: %s." (join "; " $drift)) "The environment matches the pinned values." (gt (len $drift) 0) | quote }}
    target: Composite
{{- if $vnName }}
  - type: VirtualNetworkResolved
    status: {{ ternary "True" "False" $netOK | quote }}
    reason: {{ $netReason }}
    message: {{ $netMsg | quote }}
    target: Composite
{{- end }}
{{- end }}
{{- else -}}
{{- /* 1. Subscription: pin first, then spec.subscription, then the only Ready Subscription. */ -}}
{{- $pinned := get $st "subscription" | default "" -}}
{{- $want := get $spec "subscription" | default "" -}}
{{- $chosen := dict -}}
{{- if $pinned -}}
  {{- if and $want (ne $want $pinned) }}{{ fail (printf "SubscriptionMismatch: spec.subscription is '%s' but this resource is pinned to Subscription '%s'. Create a new resource to move." $want $pinned) }}{{ end -}}
  {{- range $s := $subs }}{{ if eq $s.metadata.name $pinned }}{{ $chosen = $s }}{{ end }}{{ end -}}
  {{- if not $chosen }}{{ fail (printf "SubscriptionChanged: pinned Subscription '%s' was not found in namespace '%s'. Existing resources are kept." $pinned $ns) }}{{ end -}}
  {{- if or (not (get $st "subscriptionUid")) (not (get $st "subscriptionId")) }}{{ fail (printf "SubscriptionChanged: the pin of Subscription '%s' is incomplete. Delete and recreate this resource." $pinned) }}{{ end -}}
  {{- if ne $chosen.metadata.uid (get $st "subscriptionUid") }}{{ fail (printf "SubscriptionChanged: Subscription '%s' has a different uid than the pin (deleted and recreated?). Existing resources are kept." $pinned) }}{{ end -}}
  {{- if ne (get ($chosen.status | default dict) "subscriptionId" | default "") (get $st "subscriptionId") }}{{ fail (printf "SubscriptionChanged: Subscription '%s' reports a different subscriptionId than the pin. Existing resources are kept." $pinned) }}{{ end -}}
  {{- $isReady := false -}}
  {{- range $s := $ready }}{{ if eq $s.metadata.name $pinned }}{{ $isReady = true }}{{ end }}{{ end -}}
  {{- if not $isReady }}{{ fail (printf "SubscriptionNotReady: pinned Subscription '%s' is not Ready or is being deleted. Existing resources are kept." $pinned) }}{{ end -}}
{{- else if $want -}}
  {{- range $s := $subs }}{{ if eq $s.metadata.name $want }}{{ $chosen = $s }}{{ end }}{{ end -}}
  {{- if not $chosen }}{{ fail (printf "SubscriptionNotFound: Subscription '%s' (spec.subscription) was not found in namespace '%s'." $want $ns) }}{{ end -}}
  {{- $isReady := false -}}
  {{- range $s := $ready }}{{ if eq $s.metadata.name $want }}{{ $isReady = true }}{{ end }}{{ end -}}
  {{- if not $isReady }}{{ fail (printf "SubscriptionNotReady: Subscription '%s' is not Ready or is being deleted." $want) }}{{ end -}}
{{- else if eq (len $ready) 1 -}}
  {{- $chosen = index $ready 0 -}}
{{- else if gt (len $ready) 1 -}}
  {{- $rn := list -}}{{- range $s := $ready }}{{ $rn = append $rn $s.metadata.name }}{{ end -}}
  {{- fail (printf "SubscriptionAmbiguous: found %d Ready Subscriptions (%s). Set spec.subscription to choose one." (len $ready) (join ", " (sortAlpha $rn))) -}}
{{- else if $subs -}}
  {{- fail (printf "SubscriptionNotReady: no Subscription in namespace '%s' is Ready (found: %s)." $ns (join ", " (sortAlpha $names))) -}}
{{- else -}}
  {{- fail (printf "SubscriptionNotFound: no Subscription found in namespace '%s'. Create one, or set spec.subscription." $ns) -}}
{{- end -}}
{{- $subID := get ($chosen.status | default dict) "subscriptionId" | default "" -}}
{{- if not $subID }}{{ fail (printf "SubscriptionNotReady: Subscription '%s' has no status.subscriptionId yet." $chosen.metadata.name) }}{{ end -}}

{{- /* 2. Environment: effective location and resource group, pinned on first use. */ -}}
{{- $pinEnv := get $st "environment" | default dict -}}
{{- $loc := get $pinEnv "location" | default "" -}}
{{- $rg := get $pinEnv "resourceGroupName" | default "" -}}
{{- $locOverride := get $params "location" | default "" -}}
{{- $rgOverride := get $params "resourceGroupName" | default "" -}}
{{- $envLoc := get $env "location" | default "" -}}
{{- $envRg := get $env "resourceGroupName" | default "" -}}
{{- if not $loc }}{{ $loc = $locOverride | default $envLoc }}{{ end -}}
{{- if not $rg }}{{ $rg = $rgOverride | default $envRg }}{{ end -}}
{{- if not (regexMatch `^[a-z][a-z0-9]*$` $loc) }}{{ fail (printf "EnvironmentInvalid: the location %q is not a valid region. Set it in the platform-environment EnvironmentConfig or spec.parameters.location." $loc) }}{{ end -}}
{{- if not (regexMatch `^[A-Za-z0-9._()-]*[A-Za-z0-9_()-]$` $rg) }}{{ fail (printf "EnvironmentInvalid: the resource group %q is not valid. Set resourceGroupName in the platform-environment EnvironmentConfig or spec.parameters.resourceGroupName." $rg) }}{{ end -}}
{{- if not (get $pinEnv "location") -}}
  {{- $allowed := get $env "allowedLocations" | default "" -}}
  {{- if $allowed -}}
    {{- $list := list -}}
    {{- range $a := splitList "," $allowed }}{{ $list = append $list (trim $a | lower) }}{{ end -}}
    {{- if not (has $loc $list) }}{{ fail (printf "LocationNotAllowed: location '%s' is not in the allowed locations (%s)." $loc (join ", " $list)) }}{{ end -}}
  {{- end -}}
{{- end -}}
{{- /* Drift is informational: the pin always wins. A spec override equals the pin (immutable). */ -}}
{{- $drift := list -}}
{{- if and (get $pinEnv "location") (not $locOverride) (ne $envLoc (get $pinEnv "location")) }}{{ $drift = append $drift (printf "location is '%s' in the EnvironmentConfig, '%s' in use" $envLoc $loc) }}{{ end -}}
{{- if and (get $pinEnv "resourceGroupName") (not $rgOverride) (ne $envRg (get $pinEnv "resourceGroupName")) }}{{ $drift = append $drift (printf "resourceGroupName is '%s' in the EnvironmentConfig, '%s' in use" $envRg $rg) }}{{ end -}}

{{- /* 3. Keys this kind needs. Add a row when a building block starts using another key. The pinned value counts, so a later change of the EnvironmentConfig never fails a pinned resource. */ -}}
{{- $required := dict "VirtualNetwork" (dict "ipamPoolId" `(?i)^/subscriptions/[^/]+/resourcegroups/[^/]+/providers/microsoft\.network/networkmanagers/[^/]+/ipampools/[^/]+$`) "KeyVault" (dict "tenantId" `(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`) -}}
{{- range $key, $pattern := (get $required $kind | default dict) -}}
  {{- if not (regexMatch $pattern (get $pinEnv $key | default (get $env $key | default ""))) }}{{ fail (printf "EnvironmentInvalid: key %q is missing or malformed in the platform-environment EnvironmentConfig." $key) }}{{ end -}}
{{- end -}}
{{- /* status.environment is write-once as a whole object: once pinned it is re-emitted unchanged, and kro (which cannot read the environment context) reads it from there, one reconcile later. */ -}}
{{- $pinned := ne (get $pinEnv "location" | default "") "" -}}
{{- $ipam := "" -}}
{{- $hubOut := "" -}}
{{- $envMsg := "The platform environment is valid." -}}
{{- $envOK := true -}}
{{- $envReason := "EnvironmentValid" -}}
{{- $subnet := "" -}}
{{- $tenant := "" -}}
{{- if or (eq $kind "StorageAccount") (eq $kind "KeyVault") (eq $kind "ContainerApp") -}}
  {{- /* The private endpoint subnet (and, for KeyVault, the tenant). With networking private, an unpinned resource and a missing, placeholder or malformed subnetId is Fatal (nothing is composed or pinned, Ready is not reported). A pinned one keeps its pin and reports EnvironmentValid=False. A ContainerApp with its own infrastructureSubnetId needs no platform subnet. */ -}}
  {{- $noun := get (dict "StorageAccount" "storage account" "KeyVault" "key vault" "ContainerApp" "container app") $kind -}}
  {{- if eq $kind "KeyVault" -}}
    {{- $tenant = get $pinEnv "tenantId" | default (get $env "tenantId" | default "") -}}
    {{- if and $pinned (ne $tenant (get $env "tenantId" | default "")) }}{{ $drift = append $drift "tenantId in the EnvironmentConfig differs from the pinned tenant; the pinned tenant is kept" }}{{ end -}}
  {{- end -}}
  {{- $private := and (eq (get $params "networking" | default "private") "private") (not (and (eq $kind "ContainerApp") (get $params "infrastructureSubnetId"))) -}}
  {{- $liveSubnet := get $env "subnetId" | default "" -}}
  {{- if not (regexMatch `(?i)^/subscriptions/[^/]+/resourcegroups/[^/]+/providers/microsoft\.network/virtualnetworks/[^/]+/subnets/[^/]+$` $liveSubnet) }}{{ $liveSubnet = "" }}{{ end -}}
  {{- if and (eq $kind "ContainerApp") (get $params "infrastructureSubnetId") -}}
    {{- if or (and $liveSubnet (eq (lower (get $params "infrastructureSubnetId")) (lower $liveSubnet))) (and (get $pinEnv "subnetId") (eq (lower (get $params "infrastructureSubnetId")) (lower (get $pinEnv "subnetId")))) }}{{ fail "InfrastructureSubnetNotAllowed: infrastructureSubnetId is the platform's shared private endpoint subnet. Use a dedicated subnet delegated to Microsoft.App/environments. Nothing is created or pinned." }}{{ end -}}
  {{- end -}}
  {{- $peSubnet := ternary (get $params "privateEndpointSubnetId" | default "") "" (ne $kind "ContainerApp") -}}
  {{- if and $peSubnet $liveSubnet (eq (lower $peSubnet) (lower $liveSubnet)) }}{{ fail "PrivateEndpointSubnetNotAllowed: privateEndpointSubnetId is the platform's shared private endpoint subnet. Use a subnet of your own virtual network. Nothing is created or pinned." }}{{ end -}}
  {{- if and $peSubnet (not (hasPrefix (printf "/subscriptions/%s/" (lower $subID)) (lower $peSubnet))) }}{{ fail "PrivateEndpointSubnetWrongSubscription: privateEndpointSubnetId is not in this resource's own subscription. Use a subnet of a virtual network in the same subscription. Nothing is created or pinned." }}{{ end -}}
  {{- if $pinned -}}
    {{- $subnet = get $pinEnv "subnetId" | default "" -}}
    {{- if and (not $peSubnet) (ne $subnet $liveSubnet) }}{{ $drift = append $drift (ternary (printf "a subnetId was added to the EnvironmentConfig after this %s was created and is not used" $noun) "the subnetId in the EnvironmentConfig differs from the pinned subnet; the pinned subnet is kept" (eq $subnet "")) }}{{ end -}}
  {{- else -}}
    {{- $subnet = $peSubnet | default $liveSubnet -}}
  {{- end -}}
  {{- if and $private (not $subnet) -}}
    {{- if not $pinned }}{{ fail "SubnetNotConfigured: networking is private but the platform-environment EnvironmentConfig has no valid subnetId (missing, a placeholder or malformed). Nothing is created or pinned until the platform sets it." }}{{ end -}}
    {{- $envOK = false -}}
    {{- $envReason = "SubnetNotConfigured" -}}
    {{- $envMsg = printf "networking is private but the platform had no valid subnetId configured when this %s was created. The private endpoint is not created; recreate the %s after the platform sets subnetId." $noun $noun -}}
  {{- end -}}
{{- end -}}
{{- if eq $kind "VirtualNetwork" -}}
  {{- $peer := true -}}
  {{- if hasKey $params "peerToHub" }}{{ $peer = get $params "peerToHub" }}{{ end -}}
  {{- $liveHub := get $env "hubVirtualHubId" | default "" -}}
  {{- if hasPrefix "<" $liveHub }}{{ $liveHub = "" }}{{ end -}}
  {{- $hubRe := `(?i)^/subscriptions/[^/]+/resourcegroups/[^/]+/providers/microsoft\.network/virtualhubs/[^/]+$` -}}
  {{- if $pinned -}}
    {{- $ipam = get $pinEnv "ipamPoolId" | default "" -}}
    {{- $hubOut = get $pinEnv "hubVirtualHubId" | default "" -}}
    {{- if ne $ipam (get $env "ipamPoolId" | default "") }}{{ $drift = append $drift "ipamPoolId differs in the EnvironmentConfig; the pinned pool is kept" }}{{ end -}}
    {{- if ne $hubOut $liveHub }}{{ $drift = append $drift (ternary "a hub was added to the EnvironmentConfig after this virtual network was created and is not used" "the hub in the EnvironmentConfig differs from the pinned hub; the pinned hub is kept" (eq $hubOut "")) }}{{ end -}}
  {{- else -}}
    {{- $ipam = get $env "ipamPoolId" | default "" -}}
    {{- if and $liveHub (not (regexMatch $hubRe $liveHub)) }}{{ if $peer }}{{ fail "EnvironmentInvalid: key \"hubVirtualHubId\" is malformed in the platform-environment EnvironmentConfig." }}{{ end }}{{ else }}{{ $hubOut = $liveHub }}{{ end -}}
  {{- end -}}
  {{- if and $peer (not $hubOut) -}}
    {{- $envOK = false -}}
    {{- $envReason = "HubNotConfigured" -}}
    {{- $envMsg = ternary "peerToHub is true but the platform had no hubVirtualHubId configured when this virtual network was created. The hub connection is not created." "peerToHub is true but the platform has no hubVirtualHubId configured. The hub connection is not created." $pinned -}}
  {{- end -}}
{{- end }}
---
apiVersion: {{ $xr.apiVersion }}
kind: {{ $kind }}
status:
  subscription: {{ $chosen.metadata.name | quote }}
  subscriptionUid: {{ $chosen.metadata.uid | quote }}
  subscriptionId: {{ $subID | quote }}
  environment:
    location: {{ $loc | quote }}
    resourceGroupName: {{ $rg | quote }}
{{- if and (or (eq $kind "StorageAccount") (eq $kind "KeyVault") (eq $kind "ContainerApp")) $subnet }}
    subnetId: {{ $subnet | quote }}
{{- end }}
{{- if eq $kind "KeyVault" }}
    tenantId: {{ $tenant | quote }}
{{- end }}
{{- if eq $kind "VirtualNetwork" }}
    ipamPoolId: {{ $ipam | quote }}
{{- if $hubOut }}
    hubVirtualHubId: {{ $hubOut | quote }}
{{- end }}
{{- end }}
---
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ClaimConditions
conditions:
  - type: SubscriptionResolved
    status: "True"
    reason: SubscriptionResolved
    message: {{ printf "Using Subscription '%s' (%s)." $chosen.metadata.name (ternary "set in spec.subscription" "resolved automatically" (ne $want "")) | quote }}
    target: Composite
  - type: EnvironmentValid
    status: {{ ternary "True" "False" $envOK | quote }}
    reason: {{ $envReason }}
    message: {{ $envMsg | quote }}
    target: Composite
  - type: EnvironmentDrift
    status: {{ ternary "True" "False" (gt (len $drift) 0) | quote }}
    reason: {{ ternary "EnvironmentChanged" "InSync" (gt (len $drift) 0) }}
    message: {{ ternary (printf "Pinned values are kept: %s." (join "; " $drift)) "The environment matches the pinned values." (gt (len $drift) 0) | quote }}
    target: Composite
{{- end }}
{{- end }}
